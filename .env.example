NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime: Neon pooled connection string. Never prefix database secrets with NEXT_PUBLIC_.
DATABASE_URL=
# Direct (unpooled) connection for migrations; set by the Neon integration.
DATABASE_URL_UNPOOLED=
# Optional override for migrations; defaults to DATABASE_URL_UNPOOLED, then DATABASE_URL.
DATABASE_MIGRATION_URL=
# Authentication remains unavailable until every required value below is set.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Separate stable random key (32+ characters) for queued authentication emails.
EMAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Bearer secret for POST /api/internal/email-delivery (retry worker).
CRON_SECRET=
# Shopier REST API personal access token (Account > Personal Access Token). Server-only.
SHOPIER_API_TOKEN=
# Shopier store username (shopier.com/<store>); enables catalog sync from the public store page.
SHOPIER_STORE=
# Comma-separated webhook signing tokens (one per subscription), printed once by `pnpm run --silent shopier:webhook <https-base-url>`.
SHOPIER_WEBHOOK_TOKEN=
